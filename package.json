{
  "name": "agent-crosstalk",
  "version": "0.3.1",
  "description": "Let AI coding agents talk to each other, live, in their own desktop windows: Claude Code / Claude desktop sessions, Google Antigravity conversations and OpenAI Codex threads message each other, as orchestrator, worker, peers or just to share context. Zero dependencies.",
  "type": "module",
  "bin": {
    "crosstalk": "bin/crosstalk.js"
  },
  "files": [
    "bin",
    "lib",
    "skill",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "claude-code",
    "claude-desktop",
    "antigravity",
    "google-antigravity",
    "gemini",
    "multi-agent",
    "agent-to-agent",
    "ai-agents",
    "orchestrator",
    "coding-agents",
    "agent-orchestration",
    "agent-communication",
    "cdp",
    "agent-skills",
    "codex",
    "openai-codex",
    "chatgpt"
  ],
  "author": "khan-umirzakoff",
